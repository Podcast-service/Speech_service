FROM nvidia/cuda:12.6.3-devel-ubuntu22.04 AS builder
WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl cmake pkg-config build-essential clang llvm-dev libclang-dev \
    && rm -rf /var/lib/apt/lists/*

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --profile minimal
ENV PATH="/root/.cargo/bin:${PATH}"

COPY Cargo.toml Cargo.lock* ./
RUN mkdir src && echo "fn main() {}" > src/main.rs
RUN LIBCLANG_PATH="$(llvm-config --libdir)" cargo build --release --features cuda

COPY src ./src
RUN touch src/main.rs \
    && LIBCLANG_PATH="$(llvm-config --libdir)" cargo build --release --features cuda

FROM nvidia/cuda:12.6.3-runtime-ubuntu22.04 AS cuda-runtime

FROM python:3.11-slim
WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates ffmpeg \
    && rm -rf /var/lib/apt/lists/*

COPY --from=cuda-runtime /usr/local/cuda-12.6 /usr/local/cuda-12.6
RUN ln -s /usr/local/cuda-12.6 /usr/local/cuda

RUN python -m venv /opt/pyannote-venv \
    && /opt/pyannote-venv/bin/pip install --upgrade pip

COPY pyannote/requirements.txt ./pyannote/requirements.txt
ARG PYTORCH_VERSION=2.6.0
ARG PYTORCH_INDEX_URL=https://download.pytorch.org/whl/cu126
RUN /opt/pyannote-venv/bin/pip install --no-cache-dir \
        "torch==${PYTORCH_VERSION}" "torchaudio==${PYTORCH_VERSION}" \
        --index-url "${PYTORCH_INDEX_URL}" \
    && /opt/pyannote-venv/bin/pip install --no-cache-dir -r /app/pyannote/requirements.txt

COPY pyannote ./pyannote

COPY --from=builder /app/target/release/media_subtitle_worker /usr/local/bin/app

ENV CUDA_VERSION=12.6.3
ENV NVIDIA_REQUIRE_CUDA="cuda>=12.6"
ENV PATH="/usr/local/cuda/bin:${PATH}"
ENV LD_LIBRARY_PATH="/usr/local/cuda/lib64:/usr/local/nvidia/lib:/usr/local/nvidia/lib64"
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility
ENV TRANSCRIBER_BACKEND=whisper-rs
ENV PYANNOTE_ENABLED=true
ENV PYANNOTE_DEVICE=auto
ENV PYANNOTE_PYTHON_BIN=/opt/pyannote-venv/bin/python
ENV PYANNOTE_SCRIPT_PATH=/app/pyannote/diarize.py

CMD ["app"]
